<Project>

  <!-- Every Spindle project, and nothing from the app around it: an app's own
       Directory.Build.props (its Version, say) stops at this one. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Native AOT: every app ships compiled ahead of time, so warn at every
         build about code a trimmed or compiled build cannot run. -->
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
